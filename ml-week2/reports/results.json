      "issue": "Returns recorded on Cancelled/Pending orders",
      "table": "returns",
      "records_affected": 1685,
      "pct_of_records": 67.4,
      "impact": "Impossible business flow; Order_Status kept but treated with caution"
    },
    {
      "issue": "Return_Date earlier than Order_Date",
      "table": "returns",
      "records_affected": 1252,
      "pct_of_records": 50.1,
      "impact": "Return timing is unreliable; not used as a feature"
    },
