      "issue": "Refund_Amount larger than the order's Line_Total",
      "table": "returns",
      "records_affected": 270,
      "pct_of_records": 10.8,
      "impact": "Refund amount not used (post-event, inconsistent)"
    },
    {
      "issue": "Order placed before the customer's registration date",
      "table": "orders vs customers",
      "records_affected": 5159,
      "pct_of_records": 10.3,
      "impact": "Tenure would be negative; clipped to 0 and flagged"
    },
    {
      "issue": "Duplicate customer e-mail addresses",
      "table": "customers",
      "records_affected": 49,
      "pct_of_records": 1.0,
      "impact": "E-mail is personal data; dropped"
    },
    {
      "issue": "Duplicate customer phone numbers",
      "table": "customers",
      "records_affected": 4,
      "pct_of_records": 0.1,
      "impact": "Phone is personal data; dropped (formats are also inconsistent)"
    },
    {
      "issue": "States that appear under more than one Region",
      "table": "stores",
      "records_affected": 6,
      "pct_of_records": 60.0,
      "impact": "Store_Region is unreliable; kept as a weak feature"
